<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2ceb8396-3264-4ec9-9eaf-3147aa72eb29</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <DockerComposeProjectPath>..\..\docker\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\LZ.Common\LZ.Common.csproj" />
    <ProjectReference Include="..\..\Common\LZ.Core\LZ.Core.csproj" />
    <ProjectReference Include="..\..\Common\LZ.Model\LZ.Model.csproj" />
    <ProjectReference Include="..\..\Services\LZ.ApiService\LZ.ApiService.csproj" />
    <ProjectReference Include="..\..\Services\LZ.Finance.Service\LZ.Finance.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="RsaKeys\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LZ.Bank.Api\RsaKeys\rsa_private_key_pkcs8.pem" Link="RsaKeys\rsa_private_key_pkcs8.pem" />
    <None Include="..\LZ.Bank.Api\RsaKeys\rsa_public_key.pem" Link="RsaKeys\rsa_public_key.pem" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RsaKeys\rsa_private_key_pkcs8.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
